# Copy to .env (never commit .env) or paste into Portainer > Stack > Environment variables.
NOVA_IMAGE=ghcr.io/davidvangenechten1981/novatorrent:latest
PUID=1026
PGID=100
TZ=Europe/Brussels
WEBUI_PORT=8080
BT_PORT=6881
CONFIG_PATH=/volume1/docker/novatorrent/config
DATA_PATH=/volume1/data
# Leave empty for a random first password in CONFIG_PATH/initial_password.txt
NOVA_ADMIN_PASSWORD=
# Host names you use to open the UI, comma separated (DNS-rebinding protection)
NOVA_ALLOWED_HOSTS=
NOVA_METRICS=0
# 1 = no login for direct LAN requests (not behind a public reverse proxy; disables the completion hook)
NOVA_AUTH_DISABLED=0
# Requests per second per IP (default 30)
NOVA_RATE_LIMIT=30

# --- Only for docker-compose.gluetun.yml ---
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
OPENVPN_USER=
OPENVPN_PASSWORD=
SERVER_COUNTRIES=
LAN_SUBNET=192.168.0.0/24
VPN_PORT_FORWARDING=off
